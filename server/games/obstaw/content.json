{
  "skill": [
    { "id": 1, "sec": 30, "text": "Ułóż z 5 monet wieżę, która ustoi co najmniej 3 sekundy." },
    { "id": 2, "sec": 15, "text": "Stań na jednej nodze z zamkniętymi oczami i wytrzymaj 10 sekund." },
    { "id": 3, "sec": 30, "text": "Powiedz bez pomyłki 3 razy pod rząd: „Stół z powyłamywanymi nogami”." },
    { "id": 4, "sec": 30, "text": "Wbij monetę do pustej szklanki rzutem z odległości 1 metra (1 próba na rzut, do skutku)." },
    { "id": 5, "sec": 15, "text": "Zrób 15 przysiadów, licząc na głos." },
    { "id": 6, "sec": 30, "text": "Narysuj kółko jedną ręką, a drugą jednocześnie kwadrat — na dwóch osobnych kartkach." },
    { "id": 7, "sec": 15, "text": "Wypij pełną szklankę wody bez odrywania ust i bez używania rąk do przytrzymywania szklanki." },
    { "id": 8, "sec": 30, "text": "Wyrecytuj alfabet od tyłu, zaczynając od Ż, bez dłuższej przerwy niż 2 sekundy." },
    { "id": 9, "sec": 15, "text": "Utrzymaj długopis na czubku palca wskazującego przez 5 sekund." },
    { "id": 10, "sec": 30, "text": "Zrób 10 pompek (mogą być na kolanach)." },
    { "id": 11, "sec": 30, "text": "Zawiąż sobie jedną ręką (drugą trzymaj za plecami) sznurowadło lub wstążkę w kokardę." },
    { "id": 12, "sec": 15, "text": "Przejdź 6 kroków po prostej linii „pięta do palców”, patrząc cały czas w sufit." },
    { "id": 13, "sec": 30, "text": "Przetasuj talię kart i rozdaj 4 karty dla 4 osób — żadna karta nie może spaść na podłogę." },
    { "id": 14, "sec": 15, "text": "Powiedz 10 różnych owoców w 10 sekund, bez powtórzeń." },
    { "id": 15, "sec": 30, "text": "Złóż kartkę papieru tak, by powstał samolot, który przeleci co najmniej 2 metry." },
    { "id": 16, "sec": 30, "text": "Nie śmiej się ani nie uśmiechaj, gdy wszyscy pozostali przez 15 sekund robią do ciebie głupie miny." },
    { "id": 17, "sec": 15, "text": "Klaskaj w rytm, gdy jedna ręka robi 'góra-dół', a druga 'lewo-prawo', przez 10 sekund." },
    { "id": 18, "sec": 30, "text": "Zrób stos z 6 plastikowych kubków lub szklanek (piramida 3-2-1) bez zrzucenia żadnej." },
    { "id": 19, "sec": 15, "text": "Policz na głos od 100 do 70 co 3 (100, 97, 94…) bez pomyłki." },
    { "id": 20, "sec": 30, "text": "Zjedz suchy herbatnik (lub krakersa) i gwizdnij melodię — w ciągu 30 sekund." },
    { "id": 21, "sec": 15, "text": "Przeskocz obunóż 10 razy na jednym miejscu, mówiąc cały czas swoje imię od tyłu." },
    { "id": 22, "sec": 30, "text": "Przeczytaj na głos wybrany przez pozostałych akapit z telefonu bez jednego potknięcia." },
    { "id": 23, "sec": 30, "text": "Zrób „żabkę”: przejdź w przysiadzie 5 kroków i wstań bez podpierania się rękami." },
    { "id": 24, "sec": 15, "text": "Zamknij oczy i dotknij palcem wskazującym czubka własnego nosa 5 razy pod rząd (na zmianę prawą i lewą ręką)." },
    { "id": 25, "sec": 30, "text": "Zbuduj z kart lub pudełka wieżę z 3 pięter, która ustoi 3 sekundy." },
    { "id": 26, "sec": 15, "text": "Wymień 8 miast w Polsce w 15 sekund." },
    { "id": 27, "sec": 30, "text": "Przerzuć monetę z wierzchu dłoni do chwytu (podrzuć i złap) 5 razy pod rząd bez upuszczenia." },
    { "id": 28, "sec": 30, "text": "Powiedz zdanie „W Szczebrzeszynie chrząszcz brzmi w trzcinie” 3 razy pod rząd bez pomyłki." },
    { "id": 29, "sec": 15, "text": "Wytrzymaj w pozycji deski (plank) 15 sekund." },
    { "id": 30, "sec": 30, "text": "Na oczach wszystkich napisz swoje imię i nazwisko lewą (lub niedominującą) ręką — czytelnie, bez odrywania długopisu." }
  ],
